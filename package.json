{
  "name": "shwe-kokko-myawaddy-marketplace-bot",
  "version": "1.0.0",
  "description": "Telegram second-hand marketplace bot for Shwe Kokko and Myawaddy",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "node ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/bot.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/bot.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/config": "^7.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "pg": "^8.13.1",
    "socks-proxy-agent": "^10.1.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "prisma": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}